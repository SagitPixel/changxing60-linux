diff --git a/drivers/unisoc_platform/sprd_wlan_combo/sc2355/cmdevt.c b/drivers/unisoc_platform/sprd_wlan_combo/sc2355/cmdevt.c
index 91ee0c895..cb62f571b 100755
--- a/drivers/unisoc_platform/sprd_wlan_combo/sc2355/cmdevt.c
+++ b/drivers/unisoc_platform/sprd_wlan_combo/sc2355/cmdevt.c
@@ -2385,14 +2385,20 @@ int sc2355_set_power_backoff(struct sprd_priv *priv, struct sprd_vif *vif,
 	struct sprd_msg *msg;
 	struct cmd_set_power_backoff *p;
 
-	msg = get_cmdbuf(priv, vif, sizeof(*p), CMD_POWER_SAVE);
+	/* Stock SC2355 treats power backoff as a chip-wide command, as
+	 * in the vendor 5.4 driver. Keep the table and limits unchanged. */
+	msg = get_cmdbuf(priv, sprd_legacy_fw_compat ? NULL : vif,
+			 sizeof(*p), CMD_POWER_SAVE);
 	if (!msg)
 		return -ENOMEM;
 
 	p = (struct cmd_set_power_backoff *)msg->data;
 	memset(p, 0, sizeof(*p));
 	p->power_save_type = SPRD_SET_POWER_BACKOFF;
-	if (data)
+	/* The downstream table contains tuning for other OEM projects.
+	 * Stock compatibility uses the existing all-zero reset command:
+	 * retain this board's firmware/INI defaults and cfg80211 regdomain. */
+	if (data && !sprd_legacy_fw_compat)
 		memcpy(&p->backoff, data, sizeof(*data));
 	wl_info("power_save [SET_POWER_BACKOFF]\n");
 	return send_cmd_recv_rsp(priv, msg, NULL, NULL);
