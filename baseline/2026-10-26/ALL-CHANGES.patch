diff --git a/sound/soc/sprd/unisoc/machine/sprd-asoc-card-utils.c b/sound/soc/sprd/unisoc/machine/sprd-asoc-card-utils.c
index e6d987cb3..bc0bea020 100755
--- a/sound/soc/sprd/unisoc/machine/sprd-asoc-card-utils.c
+++ b/sound/soc/sprd/unisoc/machine/sprd-asoc-card-utils.c
@@ -678,6 +678,25 @@ static int asoc_sprd_card_dai_link_of(struct device_node *node,
 	return ret;
 }
 
+/* The qogirn6pro vendor tree includes the optional DP audio pair.
+ * Its AGCP IIS provider is not part of the phone audio build. Do not let
+ * those links prevent the independent phone sound card from registering.
+ */
+static bool sprd_card_link_enabled(struct device_node *node)
+{
+	const char *name;
+
+	if (!of_device_is_available(node))
+		return false;
+	if (IS_ENABLED(CONFIG_DRM_SPRD_DPU1) ||
+	    !of_machine_is_compatible("sprd,ums9620"))
+		return true;
+	if (of_property_read_string(node, "link-name", &name))
+		return true;
+	return strcmp(name, "AGCP_IIS0_TX") &&
+	       strcmp(name, "DisplayPort MultiMedia");
+}
+
 static int asoc_sprd_card_parse_of(struct device_node *node,
 				   struct sprd_card_data *priv)
 {
@@ -740,6 +759,8 @@ static int asoc_sprd_card_parse_of(struct device_node *node,
 		int i = 0;
 
 		for_each_child_of_node(node, np) {
+			if (!sprd_card_link_enabled(np))
+				continue;
 			dev_dbg(dev, "\tlink %d:\n", i);
 			ret = asoc_sprd_card_dai_link_of(np, priv, i, false);
 			if (ret < 0) {
@@ -819,10 +840,18 @@ int asoc_sprd_card_probe(struct platform_device *pdev,
 	}
 	 arch_audio_set_agcp_ahb_gpr(agcp_ahb_gpr);
 	/* Get the number of DAI links */
-	if (np && of_get_child_by_name(np, "sprd-audio-card,dai-link"))
-		num_links = of_get_child_count(np);
-	else
+	if (np && of_get_child_by_name(np, "sprd-audio-card,dai-link")) {
+		struct device_node *child;
+
+		num_links = 0;
+		for_each_child_of_node(np, child)
+			if (sprd_card_link_enabled(child))
+				num_links++;
+	} else {
 		num_links = 1;
+	}
+	if (!num_links)
+		return -ENODEV;
 
 	/* Allocate the private data and the DAI link array */
 	priv = devm_kzalloc(dev,
