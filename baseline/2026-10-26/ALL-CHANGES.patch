--- /dev/null
+++ b/arch/arm64/boot/dts/sprd/ums9620-7552n-probe.dts
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * ZTE 7552N (Unisoc UMS9620) - minimal probe DT for mainline Linux 6.18.
+ *
+ * Goal: boot past the early panic we hit with the full vendor DTB, and capture
+ * any later panic via ramoops so we can read it from Android after the revert.
+ *
+ * Based on sprd-linux-devs' ums9620-2h10.dts (M8 board, same SoC). Differences:
+ *   - memory: our 4 GB-4 KB at 0x80000000 (M8 declares 8 GB)
+ *   - sprd,sc-id: "ums9620 1000 1000" (read from this device) so LK picks our DTB
+ *   - ramoops node copied verbatim from the vendor DTB so 6.18's ramoops driver
+ *     binds and captures panics
+ *
+ * No USB / no audio / no PMIC sub-devices: those are what we suspect panic the
+ * 6.18 mainline drivers on the full vendor DTB. We add them back incrementally
+ * once this minimal tree boots.
+ */
+/dts-v1/;
+
+#include "ums9620.dtsi"
+
+/ {
+	model = "ZTE 7552N (UMS9620 probe)";
+	compatible = "zte,7552n-probe", "sprd,ums9620";
+	sprd,sc-id = "ums9620 1000 1000";
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0xfffff000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@fff80000 {
+			compatible = "ramoops";
+			reg = <0x0 0xfff80000 0x0 0x00040000>;
+			record-size = <0x8000>;
+			console-size = <0x8000>;
+			pmsg-size = <0x8000>;
+		};
+	};
+
+	chosen {
+		stdout-path = "serial1:921600n8";
+		bootargs = "earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,921600n8 loglevel=7 log_buf_len=4M rdinit=/init panic=10 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";
+};
