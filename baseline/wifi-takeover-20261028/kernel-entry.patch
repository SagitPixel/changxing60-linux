+/* 7552n diagnostic: which branch did sprd_dma_tx_status() take for this cookie?
+ * A fixed ring, written under the channel lock, read back through debugfs. No pointers
+ * are kept, so it stays valid after the channel is released. */
+struct sprd_diag_ent {
+	u64 nsec;
+	int chan_id;
+	int cookie;
+	int status;
+	char branch[12];
+	u32 pos;
+	bool residue_is_addr;
+};
+
+static struct sprd_diag_ent g_diag[16];
+static int g_diag_idx;
+static DEFINE_SPINLOCK(g_diag_lock);
+
+static void sprd_diag_record(int chan_id, int cookie, int status,
+			     const char *branch, u32 pos, bool is_addr)
+{
+	unsigned long f;
+	struct sprd_diag_ent *e;
+
+	spin_lock_irqsave(&g_diag_lock, f);
+	e = &g_diag[g_diag_idx & 15];
+	e->nsec = ktime_get_ns();
+	e->chan_id = chan_id;
+	e->cookie = cookie;
+	e->status = status;
+	strncpy(e->branch, branch, sizeof(e->branch) - 1);
+	e->branch[sizeof(e->branch) - 1] = '\0';
+	e->pos = pos;
+	e->residue_is_addr = is_addr;
+	g_diag_idx++;
+	spin_unlock_irqrestore(&g_diag_lock, f);
+}
+
+static int sprd_diag_show(struct seq_file *s, void *unused)
+{
+	unsigned long f;
+	int i, start;
+
+	spin_lock_irqsave(&g_diag_lock, f);
+	start = g_diag_idx > 16 ? g_diag_idx - 16 : 0;
+	for (i = start; i < g_diag_idx; i++) {
+		struct sprd_diag_ent *e = &g_diag[i & 15];
+
+		seq_printf(s, "%llu chan=%d cookie=%d status=%d branch=%s pos=%#x residue_is_addr=%d\n",
+			   e->nsec, e->chan_id, e->cookie, e->status,
+			   e->branch, e->pos, e->residue_is_addr);
+	}
+	spin_unlock_irqrestore(&g_diag_lock, f);
+	return 0;
+}
+
+static int sprd_diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, sprd_diag_show, NULL);
+}
+
+static const struct file_operations sprd_diag_fops = {
+	.open		= sprd_diag_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int __init sprd_dma_diag_init(void)
+{
+	struct dentry *dir = debugfs_create_dir("sprd-dma-diag", NULL);
+
+	if (IS_ERR_OR_NULL(dir))
+		return 0;
+	debugfs_create_file("tx_status", 0444, dir, NULL, &sprd_diag_fops);
+	return 0;
+}
+late_initcall(sprd_dma_diag_init);
