+/* ---- 7552n diagnostic: snapshots, no hardware access unless diag_read_hw=Y ----
+ *
+ * Ownership: the work lives inside struct sprd_runtime_data, which is allocated in
+ * sprd_pcm_open() (where the stream also takes its pm_runtime reference) and freed in
+ * hw_free/close. Those paths call sprd_pcm_tick_stop_sync() with no stream lock held,
