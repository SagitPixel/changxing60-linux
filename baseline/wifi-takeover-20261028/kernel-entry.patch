+module_param(diag_read_hw, bool, 0644);
+MODULE_PARM_DESC(diag_read_hw, "allow the sampler to touch power and the gate register");
+
+#define SPRD_DIAG_GATE_OFF 0x4
+#define SPRD_DIAG_GATE_MASK (BIT(17) | BIT(19))
+
+static void sprd_diag_arm(struct sprd_runtime_data *rtd)
+{
+	if (!READ_ONCE(rtd->diag_running)) {
+		WRITE_ONCE(rtd->diag_running, true);
+		spin_lock(&g_diag_lock);
+		g_diag_play_seq++;
+		g_diag_stopped = false;
+		spin_unlock(&g_diag_lock);
+		schedule_delayed_work(&rtd->diag_work, 0);
+	}
+}
+
+/* non-blocking: the worker notices on its next check and stops requeueing */
+static void sprd_diag_disarm(struct sprd_runtime_data *rtd)
+{
+	unsigned long f;
+
+	if (!READ_ONCE(rtd->diag_running))
+		return;
+	WRITE_ONCE(rtd->diag_running, false);
+	spin_lock_irqsave(&g_diag_lock, f);
+	g_diag_stopped = true;
+	spin_unlock_irqrestore(&g_diag_lock, f);
+}
+
+static void sprd_diag_work_fn(struct work_struct *w)
+{
+	struct sprd_runtime_data *rtd =
+		container_of(to_delayed_work(w), struct sprd_runtime_data, diag_work);
+	struct snd_pcm_substream *substream;
+	struct snd_pcm_runtime *runtime;
+	struct sprd_diag_snap s = { };
+	unsigned long f;
+	u32 v = 0;
+
+	if (!READ_ONCE(rtd->diag_running))
+		return;
+
+	substream = rtd->tick_substream;
+	runtime = substream ? substream->runtime : NULL;
+	if (!runtime)
+		return;
+
+	s.nsec = ktime_get_ns();
+	s.pcm_state = runtime->state;
+	s.hw_ptr = runtime->status->hw_ptr;
+	s.appl_ptr = runtime->control->appl_ptr;
+	s.pm_ret = -1;
+
+	if (diag_read_hw) {
+		int pm = pm_runtime_resume_and_get(g_dev);
+
+		s.pm_ret = pm;
+		if (pm >= 0) {
+			/* resume_and_get() only bumps usage on success, so put once here */
+			s.access_ok = agdsp_can_access() ? true : false;
+			if (s.access_ok) {
+				int r = ums9620_audcpglb_gate_read(SPRD_DIAG_GATE_OFF, &v);
+
+				s.read_done = true;
+				s.read_ret = r;
+				if (!r)
+					s.gate_raw = v;
+			}
+			pm_runtime_put_autosuspend(g_dev);
+		}
+		/* pm < 0: nothing was acquired, nothing to release, no hardware touched */
+	}
+
+	spin_lock_irqsave(&g_diag_lock, f);
+	s.play_seq = g_diag_play_seq;
+	s.smp_seq = g_diag_idx + 1;
+	g_diag_snap[g_diag_idx & (SPRD_DIAG_SLOTS - 1)] = s;
+	g_diag_idx++;
+	spin_unlock_irqrestore(&g_diag_lock, f);
+
+	if (READ_ONCE(rtd->diag_running))
+		schedule_delayed_work(&rtd->diag_work, msecs_to_jiffies(300));
+}
+
+static int sprd_diag_show(struct seq_file *s, void *unused)
+{
+	struct sprd_diag_snap copy[SPRD_DIAG_SLOTS];
+	unsigned long f;
+	u32 n, play_seq;
+	bool stopped;
+	int i, start;
+
+	/* copy under the lock, format after it */
+	spin_lock_irqsave(&g_diag_lock, f);
+	n = g_diag_idx;
+	play_seq = g_diag_play_seq;
+	stopped = g_diag_stopped;
+	memcpy(copy, g_diag_snap, sizeof(copy));
+	spin_unlock_irqrestore(&g_diag_lock, f);
+
+	seq_printf(s, "target=sprd,ums9620-audcpglb-gate off=%#x mask=%#x read_hw=%d\n",
+		   SPRD_DIAG_GATE_OFF, SPRD_DIAG_GATE_MASK, diag_read_hw);
+	seq_printf(s, "play_seq=%u stopped=%d total=%u\n", play_seq, stopped, n);
+
+	if (!n) {
+		seq_puts(s, "state=no_sample\n");
+		return 0;
+	}
+
+	start = n > SPRD_DIAG_SLOTS ? n - SPRD_DIAG_SLOTS : 0;
+	for (i = start; i < (int)n; i++) {
+		struct sprd_diag_snap *c = &copy[i & (SPRD_DIAG_SLOTS - 1)];
+
+		seq_printf(s, "%llu play=%u smp=%d pm_ret=%d access_ok=%d read_done=%d read_ret=%d gate_raw=%#010x vbc_ap_eb=%d aud_ap_eb=%d state=%d hw_ptr=%lu appl_ptr=%lu\n",
+			   c->nsec, c->play_seq, i + 1, c->pm_ret, c->access_ok,
+			   c->read_done, c->read_ret,
+			   (c->read_done && !c->read_ret) ? c->gate_raw : 0,
+			   (c->read_done && !c->read_ret) ? !!(c->gate_raw & BIT(17)) : -1,
+			   (c->read_done && !c->read_ret) ? !!(c->gate_raw & BIT(19)) : -1,
+			   c->pcm_state, c->hw_ptr, c->appl_ptr);
+	}
+	return 0;
+}
+
+static int sprd_diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, sprd_diag_show, NULL);
+}
+
+static const struct file_operations sprd_diag_fops = {
+	.open		= sprd_diag_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
