+/*
+ * The 7552n ships the vendor 5.4 device tree, which does not carry the
+ * sprd,ufs-anlg-syscon / sprd,aon-apb-syscon phandles this driver expects.
+ * It instead describes the same registers the way the 5.4 driver did:
+ *	phy_sram_ext_ld_done = <&syscon 0xc 0x2>;
+ * The phandle is the same node, so fall back to those property names.
+ */
+static const char * const ufs_sprd_anlg_alias[] = {
+	"phy_sram_ext_ld_done", "phy_sram_bypass", "phy_sram_init_done", NULL,
+};
+static const char * const ufs_sprd_aon_alias[] = {
+	"aon_apb_ufs_clk_en", "ufsdev_refclk_en", "usb31pllv_ref2mphy_en", NULL,
+};
+
+static struct regmap *ufs_sprd_lookup_syscon(struct device_node *np,
+					     const char *name)
+{
+	const char * const *alias = NULL;
+	struct regmap *map;
+	int i;
+
+	map = syscon_regmap_lookup_by_phandle(np, name);
+	if (!IS_ERR(map))
+		return map;
+
+	/*
+	 * Only the analog block gets the fallback. Letting the AON_APB syscon
+	 * resolve as well would also enable its APB_USB31PLL_CTRL /
+	 * APB_UFSDEV_REG writes, and we do not know yet which of the two is
+	 * the one that wedges the bus.
+	 */
+	if (!strcmp(name, "sprd,ufs-anlg-syscon"))
+		alias = ufs_sprd_anlg_alias;
+
+	(void)ufs_sprd_aon_alias;
+
+	for (i = 0; alias && alias[i]; i++) {
+		map = syscon_regmap_lookup_by_phandle(np, alias[i]);
+		if (!IS_ERR(map)) {
+			pr_info("ufs-sprd: %s resolved via vendor property %s\n",
+				name, alias[i]);
+			return map;
+		}
+	}
+
+	return ERR_PTR(-ENODEV);
+}
