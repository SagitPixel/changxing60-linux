{
	"changxing60-at": {
		"instances": {
			"atd": {
				"running": true,
				"pid": 3951,
				"command": [
					"/bin/sh",
					"-c",
					"n=0; while [ ! -c /dev/stty_nr1 ]; do n=$((n+1)); [ \"$n\" -gt 240 ] && { echo 'changxing60-at: /dev/stty_nr1 never appeared' >&2; exit 1; }; sleep 1; done; exec /opt/changxing60/bin/changxing60-atd"
				],
				"term_timeout": 5,
				"respawn": {
					"threshold": 3600,
					"timeout": 10,
					"retry": 0
				}
			}
		}
	},
