+/* Same read-clock sequence and block-6 IPD field as the 7552N stock BSP.
+ * These writes enable reading; no eFuse programming control is touched.
+ * Callers hold WCN power: firmware download, then WLAN initialization.
+ */
+int wcn_get_ipd_vendor_id(void)
+{
+	static DEFINE_MUTEX(ipd_lock);
+	static int cached_id = -1;
+	static const struct { u32 reg, mask; } clocks[] = {
+		{ 0x4083c32c, BIT(22) },
+		{ 0x4083c024, BIT(11) },
+		{ 0x4083c050, BIT(18) },
+		{ 0x40858040, BIT(0) },
+	};
+	struct wcn_match_data *match = get_wcn_match_config();
+	u32 raw;
+	int ret, i;
+
+	if (!match || !match->unisoc_wcn_m3lite)
+		return -EOPNOTSUPP;
+	mutex_lock(&ipd_lock);
+	if (cached_id >= 0) {
+		ret = cached_id;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(clocks); i++) {
+		ret = sprdwcn_bus_reg_read(clocks[i].reg, &raw, sizeof(raw));
+		if (ret < 0)
+			goto out;
+		if (!(raw & clocks[i].mask)) {
+			raw |= clocks[i].mask;
+			ret = sprdwcn_bus_reg_write(clocks[i].reg, &raw, sizeof(raw));
+			if (ret < 0)
+				goto out;
+		}
+	}
+	ret = sprdwcn_bus_reg_read(0x40859030, &raw, sizeof(raw));
+	if (ret < 0)
+		goto out;
+	cached_id = (raw >> 29) & 3;
+	ret = cached_id;
+	pr_info("WCN IPD vendor=%d (XPE=%d)\n", ret, ret == 1);
+out:
+	mutex_unlock(&ipd_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wcn_get_ipd_vendor_id);
