 	} else if (schan->cur_desc && schan->cur_desc->vd.tx.cookie == cookie) {
 		struct sprd_dma_desc *sdesc = schan->cur_desc;
 
@@ -762,8 +847,10 @@ static enum dma_status sprd_dma_tx_status(struct dma_chan *chan,
 			pos = sprd_dma_get_dst_addr(schan);
 		else
 			pos = sprd_dma_get_src_addr(schan);
+		sprd_diag_record(chan->chan_id, cookie, ret, "current", pos, true);
 	} else {
 		pos = 0;
+		sprd_diag_record(chan->chan_id, cookie, ret, "unmatched", 0, false);
 	}
 	spin_unlock_irqrestore(&schan->vc.lock, flags);
 
