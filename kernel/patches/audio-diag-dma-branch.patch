+static atomic64_t sprd_tick_count = ATOMIC64_INIT(0);
+static atomic64_t sprd_ptr_count = ATOMIC64_INIT(0);
+static bool tick_log = true;
+module_param(tick_log, bool, 0644);
+MODULE_PARM_DESC(tick_log, "log every 100 period-timer callbacks");
