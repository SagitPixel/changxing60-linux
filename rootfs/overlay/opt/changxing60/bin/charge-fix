#!/bin/sh
# The 6.18 native charger-manager owns charging limits and temperature policy.
# Retain the previous 5.4 implementation only as an explicitly saved fallback.
case "$(uname -r)" in
    6.*) exit 0 ;;
    *)
        if [ -x /opt/changxing60/bin/charge-fix.legacy-5.4 ]; then
            exec /opt/changxing60/bin/charge-fix.legacy-5.4 "$@"
        fi
        exit 0
        ;;
esac
